generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum TaskStatus { QUEUED PLANNING RUNNING WAITING_FOR_APPROVAL PAUSED COMPLETED FAILED CANCELLED }
enum Risk { LOW MEDIUM HIGH }
model User { id String @id @default(cuid()) email String @unique passwordHash String? displayName String? createdAt DateTime @default(now()) conversations Conversation[] tasks Task[] memories Memory[] files FileObject[] credentials ApiCredential[] settings UserSetting? }
model Conversation { id String @id @default(cuid()) userId String title String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId],references:[id],onDelete:Cascade) messages Message[] @@index([userId,updatedAt]) }
model Message { id String @id @default(cuid()) conversationId String role String content Json createdAt DateTime @default(now()) conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade) @@index([conversationId,createdAt]) }
model Agent { id String @id @default(cuid()) ownerId String? name String capabilities Json enabled Boolean @default(true) createdAt DateTime @default(now()) }
model Task { id String @id @default(cuid()) userId String title String description String status TaskStatus @default(QUEUED) priority Int @default(1) progress Int @default(0) currentActivity String? result Json? errorCode String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId],references:[id],onDelete:Cascade) steps TaskStep[] executions ToolExecution[] approvals Approval[] events AgentEvent[] @@index([userId,status,updatedAt]) }
model TaskStep { id String @id @default(cuid()) taskId String position Int title String safeSummary String status String task Task @relation(fields:[taskId],references:[id],onDelete:Cascade) @@unique([taskId,position]) }
model Tool { id String @id @default(cuid()) name String @unique description String inputSchema Json outputSchema Json? risk Risk enabled Boolean @default(true) executions ToolExecution[] }
model ToolExecution { id String @id @default(cuid()) taskId String toolId String input Json output Json? status String durationMs Int? errorCode String? createdAt DateTime @default(now()) task Task @relation(fields:[taskId],references:[id],onDelete:Cascade) tool Tool @relation(fields:[toolId],references:[id]) @@index([taskId,createdAt]) }
model Memory { id String @id @default(cuid()) userId String kind String content String metadata Json? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,kind,updatedAt]) }
model FileObject { id String @id @default(cuid()) userId String name String mimeType String size Int storageKey String sha256 String status String @default("QUARANTINED") createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,createdAt]) }
model ModelProvider { id String @id @default(cuid()) slug String @unique displayName String configSchema Json credentials ApiCredential[] }
model ApiCredential { id String @id @default(cuid()) userId String providerId String encryptedValue Bytes keyVersion Int createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId],references:[id],onDelete:Cascade) provider ModelProvider @relation(fields:[providerId],references:[id]) @@unique([userId,providerId]) }
model Approval { id String @id @default(cuid()) taskId String action String description String risk Risk status String @default("PENDING") payload Json? decidedAt DateTime? task Task @relation(fields:[taskId],references:[id],onDelete:Cascade) @@index([taskId,status]) }
model Notification { id String @id @default(cuid()) userId String type String title String body String readAt DateTime? createdAt DateTime @default(now()) @@index([userId,createdAt]) }
model AgentEvent { id String @id @default(cuid()) taskId String? userId String type String payload Json createdAt DateTime @default(now()) task Task? @relation(fields:[taskId],references:[id],onDelete:Cascade) @@index([userId,createdAt]) @@index([taskId,createdAt]) }
model UserSetting { userId String @id autonomy String @default("BALANCED") toolPolicy String @default("ASK_RISKY") maxIterations Int @default(12) maxDurationSec Int @default(900) memoryEnabled Boolean @default(true) user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
